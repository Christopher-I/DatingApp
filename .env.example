# Copy to .env and fill in. Nothing here is required for the offline demo/tests.

# --- Data ---
# Local dev uses SQLite at this path. Leave blank to use ./copilot_dev.db
COPILOT_DB_PATH=

# Production: Supabase / Postgres + pgvector connection string
# COPILOT_PG_DSN=postgresql://user:pass@host:5432/dbname

# --- Vision ---
# hash  = deterministic stub (no deps, for dev/tests)
# clip  = real open_clip embeddings (requires torch + open_clip installed)
COPILOT_EMBEDDER=hash
COPILOT_CLIP_MODEL=ViT-B-32
COPILOT_CLIP_PRETRAINED=laion2b_s34b_b79k

# --- Messaging drafter ---
# stub      = deterministic templated draft (no network)
# anthropic = real LLM drafts (requires the anthropic SDK + a key)
COPILOT_DRAFTER=stub
ANTHROPIC_API_KEY=
COPILOT_DRAFT_MODEL=claude-opus-5

# --- Safety / scheduling defaults (can also be stored in the settings table) ---
COPILOT_DAILY_CAP=50
COPILOT_SESSION_MIN=30
COPILOT_SESSION_MAX=50
